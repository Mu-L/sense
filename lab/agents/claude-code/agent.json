{
  "id": "claude-code",
  "binary": "claude",
  "model_flag": "--model",
  "headless_args": [
    "-p",
    "--output-format",
    "stream-json",
    "--verbose",
    "--permission-mode",
    "bypassPermissions"
  ],
  "judge_args": [
    "-p",
    "--output-format",
    "text",
    "--allowedTools",
    ""
  ],
  "env": [
    "IS_SANDBOX=1",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY=1"
  ],
  "supports_mcp": true,
  "auth_modes": [
    "subscription",
    "api_key"
  ],
  "config_dirs": [
    ".claude"
  ]
}
